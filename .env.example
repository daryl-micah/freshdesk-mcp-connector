# Freshdesk > Profile Settings > API Key
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=your_api_key
# Optional: register the write tools (reply, note, update, assign, tags). Off unless exactly 1.
# FRESHDESK_ALLOW_WRITES=1
# Optional: register verify_payment_refs (Razorpay test-mode keys are fine)
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
